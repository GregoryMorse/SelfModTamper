theorem dyn_blocks : ∀ j, j < 82 → ∀ k, k < 100 → dynAt (100 * j + k) = blobByte dynBlob (100 * j + k) ∨ 8123 ≤ 100 * j + k := by
  intro j hj k hk
  rcases (by omega : j < 10 ∨ (10 ≤ j ∧ j < 20) ∨ (20 ≤ j ∧ j < 30) ∨ (30 ≤ j ∧ j < 40) ∨ (40 ≤ j ∧ j < 50) ∨ (50 ≤ j ∧ j < 60) ∨ (60 ≤ j ∧ j < 70) ∨ (70 ≤ j ∧ j < 80) ∨ 80 ≤ j) with h | h | h | h | h | h | h | h | h
  · have := dyn_blocks_0 (j - 0) (by omega) k hk
    rwa [show 0 + (j - 0) = j by omega] at this
  · have := dyn_blocks_1 (j - 10) (by omega) k hk
    rwa [show 10 + (j - 10) = j by omega] at this
  · have := dyn_blocks_2 (j - 20) (by omega) k hk
    rwa [show 20 + (j - 20) = j by omega] at this
  · have := dyn_blocks_3 (j - 30) (by omega) k hk
    rwa [show 30 + (j - 30) = j by omega] at this
  · have := dyn_blocks_4 (j - 40) (by omega) k hk
    rwa [show 40 + (j - 40) = j by omega] at this
  · have := dyn_blocks_5 (j - 50) (by omega) k hk
    rwa [show 50 + (j - 50) = j by omega] at this
  · have := dyn_blocks_6 (j - 60) (by omega) k hk
    rwa [show 60 + (j - 60) = j by omega] at this
  · have := dyn_blocks_7 (j - 70) (by omega) k hk
    rwa [show 70 + (j - 70) = j by omega] at this
  · have := dyn_blocks_8 (j - 80) (by omega) k hk
    rwa [show 80 + (j - 80) = j by omega] at this

