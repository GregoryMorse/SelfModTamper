theorem dyn_image_eq : ∀ i, i < 8123 → dynAt i = blobByte dynBlob i := by
  intro i hi
  have := forall_blocks (fun i => dynAt i = blobByte dynBlob i ∨ 8123 ≤ i) 82 100 dyn_blocks i (by omega)
  rcases this with h | h
  · exact h
  · omega
theorem static_image_eq : ∀ i, i < 8123 → staticAt i = blobByte tpCompLoopObjBlob i := by
  intro i hi
  have := forall_blocks (fun i => staticAt i = blobByte tpCompLoopObjBlob i ∨ 8123 ≤ i) 82 100 static_blocks i (by omega)
  rcases this with h | h
  · exact h
  · omega
theorem tpcomp_image_eq : ∀ i, i < 53 → tpCompImage.getD i 0 = blobByte tpCompObjBlob i := by decide +kernel
theorem tpcomp_image_length : tpCompImage.length = 53 := by decide +kernel

/-- Every instruction of the loop body decodes back from both of its encodings (AsmJit's and MASM's). -/
theorem loopBody_roundtrips_A :
    ∀ i ∈ loopBody, decodeL (encodeA i ++ pad) = some (i, (encodeA i).length) := by decide +kernel
theorem loopBody_roundtrips_M :
    ∀ i ∈ loopBody, decodeL (encode i ++ pad) = some (i, (encode i).length) := by decide +kernel

