/-! ## Assembled and generated bytes equal the Lean images (C20, C25, C27, C29; M-class data)

The data in `LayoutData` are what MASM (`ml64`, relocations resolved) and AsmJit (`gen_asm`, via
`validation/native/smc_harness.cpp`) emitted on the author's toolchain; they are evidence about those tools, not
proof. The theorems say these bytes are exactly the encodings of one instruction list built from `Spec/Layout`. -/

/-- Byte `i` of a little-endian blob. -/
def blobByte (n i : Nat) : Nat := (n >>> (8 * i)) % 256

theorem loopLen_8123 : loopLen = 8123 := by decide +kernel

/-- Bounded quantification in blocks, so that the kernel's recursion stays shallow. -/
theorem forall_blocks (P : Nat → Prop) (J K : Nat) (h : ∀ j, j < J → ∀ k, k < K → P (K * j + k)) :
    ∀ i, i < J * K → P i := by
  intro i hi
  have hK : 0 < K := by
    cases K with
    | zero => simp at hi
    | succ _ => omega
  have := h (i / K) (by rw [Nat.div_lt_iff_lt_mul hK]; exact hi) (i % K) (Nat.mod_lt _ hK)
  rwa [Nat.div_add_mod] at this
  
theorem dyn_blocks_0 : ∀ j, j < 10 → ∀ k, k < 100 →
    dynAt (100 * (0 + j) + k) = blobByte dynBlob (100 * (0 + j) + k) ∨ 8123 ≤ 100 * (0 + j) + k := by
  decide +kernel
