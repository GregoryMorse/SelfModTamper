-- ===== SmcTamper.Spec.Bits =====
namespace SmcTamper

/-- Byte-addressed memory: the content at each natural-number address. -/
abbrev Mem := Nat → BitVec 8

/-- Little-endian 64-bit read: the byte at `a` is the least significant. -/
@[expose] def rd64 (m : Mem) (a : Nat) : BitVec 64 :=
  (m a).setWidth 64 ||| ((m (a + 1)).setWidth 64 <<< 8) ||| ((m (a + 2)).setWidth 64 <<< 16) |||
  ((m (a + 3)).setWidth 64 <<< 24) ||| ((m (a + 4)).setWidth 64 <<< 32) |||
  ((m (a + 5)).setWidth 64 <<< 40) ||| ((m (a + 6)).setWidth 64 <<< 48) |||
  ((m (a + 7)).setWidth 64 <<< 56)

/-- Write one byte. -/
@[expose] def wr8 (m : Mem) (a : Nat) (b : BitVec 8) : Mem := fun x => if x = a then b else m x

/-- The number of one bits in the byte is even (the x86 parity-flag convention; PF looks at the low byte only). -/
@[expose] def evenParity8 (b : BitVec 8) : Bool :=
  !(b.getLsbD 0 ^^ b.getLsbD 1 ^^ b.getLsbD 2 ^^ b.getLsbD 3 ^^ b.getLsbD 4 ^^ b.getLsbD 5 ^^ b.getLsbD 6 ^^
    b.getLsbD 7)

/-- Parity flag of a result: even parity of its low byte. -/
@[expose] def pf {w : Nat} (x : BitVec w) : Bool := evenParity8 (x.setWidth 8)

/-- Sign flag of a result: its most significant bit. -/
@[expose] def sf {w : Nat} (x : BitVec w) : Bool := x.msb

/-- The next toggle of the operation number: parity (weight 4) and sign (weight 1) of the result. -/
@[expose] def toggle (res : BitVec 64) : Nat := (if pf res then 4 else 0) ||| (if sf res then 1 else 0)

/-- Bits 3 to 5 of a byte: the `reg` field of the ALU opcode (Table 2, column Opcode[3:5]). -/
@[expose] def aluField (b : BitVec 8) : Nat := (b.toNat >>> 3) % 8

end SmcTamper
-- ===== SmcTamper.Spec.ISA =====
namespace SmcTamper

/-- The five modelled status flags. -/
structure Flags where
  cf : Bool
  pf : Bool
  zf : Bool
  sf : Bool
  ovf : Bool
  deriving DecidableEq

/-- Instructions. Registers are numbered as in the encoding (`rax = 0, rcx = 1, rdx = 2, rbx = 3, rsp = 4,
rbp = 5, rsi = 6, rdi = 7, r8 = 8`). `f` is the 3-bit ALU function: `0 ADD, 1 OR, 2 ADC, 3 SBB, 4 AND, 5 SUB,
6 XOR, 7 CMP`. Memory operands are `[base]` (no displacement) or `[rip + disp32]`. -/
inductive Instr where
  | alu (f : Fin 8) (dst src : Fin 16)             -- REX.W (f*8+3) /r, register source
  | aluM (f : Fin 8) (dst base : Fin 16)           -- REX.W (f*8+3) /r, source `qword [base]`
  | movRR (dst src : Fin 16)                       -- REX.W 8B /r
  | movStore (base src : Fin 16)                   -- REX.W 89 /r, `mov qword [base], src`
  | aluRI (f : Fin 8) (r : Fin 16) (imm : BitVec 32)   -- REX.W 81 /f id (sign-extended)
  | aluRI8_32 (f : Fin 8) (r : Fin 16) (imm : BitVec 8) -- 83 /f ib on a 32-bit register (zero-extends)
  | shiftI (k : Fin 8) (r : Fin 16) (n : BitVec 8) -- REX.W C1 /k ib (k = 4 SHL, 5 SHR)
  | dec (r : Fin 16)                               -- REX.W FF /1
  | imulI (dst src : Fin 16) (imm : BitVec 8)      -- REX.W 6B /r ib
  | movI32 (r : Fin 16) (imm : BitVec 32)          -- REX.W C7 /0 id (sign-extended)
  | movI64 (r : Fin 16) (imm : BitVec 64)          -- REX.W B8+r io
  | leaD (dst base : Fin 16) (d : BitVec 8)        -- REX.W 8D /r, `[base + disp8]`
  | leaSib (dst base index : Fin 16)               -- REX.W 8D /r SIB, `[base + index]`
  | setcc (cc : Fin 16) (r : Fin 4)                -- 0F 90+cc /0 on AL, CL, DL, BL
  | shlB (r : Fin 4) (n : BitVec 8)                -- C0 /4 ib on AL, CL, DL, BL
  | orB (dst src : Fin 4)                          -- 0A /r on AL, CL, DL, BL
  | xorMB (disp : BitVec 32) (src : Fin 4)         -- 30 /r, `xor byte [rip + disp], src`
  | aluMR32 (f : Fin 8) (disp : BitVec 32) (src : Fin 16)  -- (f*8+1) /r, `op dword [rip + disp], src32`
  | aluMR64 (f : Fin 8) (disp : BitVec 32) (src : Fin 16)  -- REX.W (f*8+1) /r, `op qword [rip + disp], src`
  | clc
  | jcc (cc : Fin 16) (rel : BitVec 8)
  | jmp32 (rel : BitVec 32)
  | nop
  deriving DecidableEq

/-- Little-endian 32-bit value from four bytes (each below 256). -/
def le32 (a b c d : Nat) : BitVec 32 := BitVec.ofNat 32 (a + 256 * b + 65536 * c + 16777216 * d)

/-- Little-endian 64-bit value from eight bytes. -/
def le64 (a b c d e f g h : Nat) : BitVec 64 :=
  BitVec.ofNat 64 (a + 256 * (b + 256 * (c + 256 * (d + 256 * (e + 256 * (f + 256 * (g + 256 * h)))))))

/-- Decode a REX.W-prefixed instruction; `x` is the low three bits of the prefix (`R`, `X`, `B`). The returned length
excludes the prefix byte. -/
def decodeRexW (x : Nat) (r : List Nat) : Option (Instr × Nat) :=
  let hi (m : Nat) : Fin 16 := Fin.ofNat 16 (x / 4 % 2 * 8 + m / 8 % 8)
  let lo (m : Nat) : Fin 16 := Fin.ofNat 16 (x % 2 * 8 + m % 8)
  match r with
  | op :: m :: rest =>
    if op < 0x40 ∧ op % 8 = 3 ∧ m / 64 = 3 then some (.alu (Fin.ofNat 8 (op / 8)) (hi m) (lo m), 2)
    else if op < 0x40 ∧ op % 8 = 3 ∧ m / 64 = 0 ∧ m % 8 ≠ 4 ∧ m % 8 ≠ 5 then
      some (.aluM (Fin.ofNat 8 (op / 8)) (hi m) (lo m), 2)
    else if op = 0x8B ∧ m / 64 = 3 then some (.movRR (hi m) (lo m), 2)
    else if op = 0x89 ∧ m / 64 = 3 then some (.movRR (lo m) (hi m), 2)
    else if op < 0x40 ∧ op % 8 = 1 ∧ m / 64 = 3 then some (.alu (Fin.ofNat 8 (op / 8)) (lo m) (hi m), 2)
    else if op = 0x89 ∧ m / 64 = 0 ∧ m % 8 ≠ 4 ∧ m % 8 ≠ 5 then some (.movStore (lo m) (hi m), 2)
    else if op = 0x81 ∧ m / 64 = 3 then
      match rest with
      | a :: b :: c :: d :: _ => some (.aluRI (Fin.ofNat 8 (m / 8 % 8)) (lo m) (le32 a b c d), 6)
      | _ => none
    else if op = 0xC1 ∧ m / 64 = 3 ∧ (m / 8 % 8 = 4 ∨ m / 8 % 8 = 5) then
      match rest with
      | n :: _ => some (.shiftI (Fin.ofNat 8 (m / 8 % 8)) (lo m) (BitVec.ofNat 8 n), 3)
      | _ => none
    else if op = 0xFF ∧ m / 64 = 3 ∧ m / 8 % 8 = 1 then some (.dec (lo m), 2)
    else if op = 0x6B ∧ m / 64 = 3 then
      match rest with
      | i :: _ => some (.imulI (hi m) (lo m) (BitVec.ofNat 8 i), 3)
      | _ => none
    else if op = 0xC7 ∧ m / 64 = 3 ∧ m / 8 % 8 = 0 then
      match rest with
      | a :: b :: c :: d :: _ => some (.movI32 (lo m) (le32 a b c d), 6)
      | _ => none
    else if op = 0x8D ∧ m / 64 = 1 ∧ m % 8 ≠ 4 then
      match rest with
      | d :: _ => some (.leaD (hi m) (lo m) (BitVec.ofNat 8 d), 3)
      | _ => none
    else if op = 0x8D ∧ m / 64 = 0 ∧ m % 8 = 4 then
      match rest with
      | s :: _ =>
        if s / 64 = 0 ∧ x / 2 % 2 * 8 + s / 8 % 8 ≠ 4 then
          some (.leaSib (hi m) (Fin.ofNat 16 (x % 2 * 8 + s % 8)) (Fin.ofNat 16 (x / 2 % 2 * 8 + s / 8 % 8)), 3)
        else none
      | _ => none
    else if op < 0x40 ∧ op % 8 = 1 ∧ m / 64 = 0 ∧ m % 8 = 5 then
      match rest with
      | a :: b :: c :: d :: _ => some (.aluMR64 (Fin.ofNat 8 (op / 8)) (le32 a b c d) (hi m), 6)
      | _ => none
    else if 0xB8 ≤ op ∧ op ≤ 0xBF then
      match m :: rest with
      | a :: b :: c :: d :: e :: f :: g :: h :: _ =>
        some (.movI64 (Fin.ofNat 16 (x % 2 * 8 + (op - 0xB8))) (le64 a b c d e f g h), 9)
      | _ => none
    else none
  | _ => none

/-- Decode an instruction without a REX prefix. -/
def decodePlain (b0 : Nat) (r : List Nat) : Option (Instr × Nat) :=
  if b0 = 0xF8 then some (.clc, 1)
  else if b0 = 0x90 then some (.nop, 1)
  else if 0x70 ≤ b0 ∧ b0 ≤ 0x7F then
    match r with
    | d :: _ => some (.jcc (Fin.ofNat 16 (b0 - 0x70)) (BitVec.ofNat 8 d), 2)
    | _ => none
  else if b0 = 0xE9 then
    match r with
    | a :: b :: c :: d :: _ => some (.jmp32 (le32 a b c d), 5)
    | _ => none
  else if b0 = 0x0F then
    match r with
    | b1 :: m :: _ =>
      if 0x90 ≤ b1 ∧ b1 ≤ 0x9F ∧ m / 8 = 24 ∧ m % 8 < 4 then
        some (.setcc (Fin.ofNat 16 (b1 - 0x90)) (Fin.ofNat 4 (m % 8)), 3)
      else none
    | _ => none
  else if b0 = 0xC0 then
    match r with
    | m :: n :: _ =>
      if m / 8 = 28 ∧ m % 8 < 4 then some (.shlB (Fin.ofNat 4 (m % 8)) (BitVec.ofNat 8 n), 3) else none
    | _ => none
  else if b0 = 0x08 then
    match r with
    | m :: _ =>
      if m / 64 = 3 ∧ m / 8 % 8 < 4 ∧ m % 8 < 4 then
        some (.orB (Fin.ofNat 4 (m % 8)) (Fin.ofNat 4 (m / 8 % 8)), 2)
      else none
    | _ => none
  else if b0 = 0x0A then
    match r with
    | m :: _ =>
      if m / 64 = 3 ∧ m / 8 % 8 < 4 ∧ m % 8 < 4 then
        some (.orB (Fin.ofNat 4 (m / 8 % 8)) (Fin.ofNat 4 (m % 8)), 2)
      else none
    | _ => none
  else if b0 = 0x30 then
    match r with
    | m :: a :: b :: c :: d :: _ =>
      if m / 64 = 0 ∧ m % 8 = 5 ∧ m / 8 % 8 < 4 then some (.xorMB (le32 a b c d) (Fin.ofNat 4 (m / 8 % 8)), 6)
      else none
    | _ => none
  else if b0 = 0x83 then
    match r with
    | m :: i :: _ =>
      if m / 64 = 3 ∧ m % 8 < 8 then
        some (.aluRI8_32 (Fin.ofNat 8 (m / 8 % 8)) (Fin.ofNat 16 (m % 8)) (BitVec.ofNat 8 i), 3)
      else none
    | _ => none
  else if b0 < 0x40 ∧ b0 % 8 = 1 then
    match r with
    | m :: a :: b :: c :: d :: _ =>
      if m / 64 = 0 ∧ m % 8 = 5 then
        some (.aluMR32 (Fin.ofNat 8 (b0 / 8)) (le32 a b c d) (Fin.ofNat 16 (m / 8 % 8)), 6)
      else none
    | _ => none
  else none

/-- Decode one instruction from a list of byte values; returns the instruction and its length in bytes. -/
def decodeL : List Nat → Option (Instr × Nat)
  | [] => none
  | b0 :: r =>
    if 0x48 ≤ b0 ∧ b0 ≤ 0x4F then (decodeRexW (b0 - 0x48) r).map (fun p => (p.1, p.2 + 1))
    else decodePlain b0 r

/-- The `n` bytes starting at `a`, as natural numbers. -/
def bytesAt (m : Mem) (a n : Nat) : List Nat := (List.range n).map (fun k => (m (a + k)).toNat)

/-- Decode the instruction at address `a` of the *current* memory (at most 10 bytes are read). -/
def decode (m : Mem) (a : Nat) : Option (Instr × Nat) := decodeL (bytesAt m a 10)

end SmcTamper
-- ===== SmcTamper.Spec.Step =====
namespace SmcTamper

/-- Machine state: general registers, instruction pointer, status flags and byte memory. -/
structure St where
  regs : Fin 16 → BitVec 64
  rip : Nat
  fl : Flags
  mem : Mem

def St.setReg (s : St) (r : Fin 16) (v : BitVec 64) : St := { s with regs := fun i => if i = r then v else s.regs i }

/-- The low byte of register `r` (AL, CL, DL, BL for `r < 4`). -/
def St.low8 (s : St) (r : Fin 4) : BitVec 8 := (s.regs ⟨r.val, by omega⟩).setWidth 8

/-- Write the low byte, keeping the other 56 bits. -/
def St.setLow8 (s : St) (r : Fin 4) (v : BitVec 8) : St :=
  s.setReg ⟨r.val, by omega⟩ ((s.regs ⟨r.val, by omega⟩ &&& ~~~0xFF#64) ||| v.setWidth 64)

def rd32 (m : Mem) (a : Nat) : BitVec 32 :=
  (m a).setWidth 32 ||| ((m (a + 1)).setWidth 32 <<< 8) ||| ((m (a + 2)).setWidth 32 <<< 16) |||
  ((m (a + 3)).setWidth 32 <<< 24)

def wr32 (m : Mem) (a : Nat) (v : BitVec 32) : Mem :=
  wr8 (wr8 (wr8 (wr8 m a (v.setWidth 8)) (a + 1) ((v >>> 8).setWidth 8)) (a + 2) ((v >>> 16).setWidth 8))
    (a + 3) ((v >>> 24).setWidth 8)

def wr64 (m : Mem) (a : Nat) (v : BitVec 64) : Mem :=
  wr8 (wr8 (wr8 (wr8 (wr8 (wr8 (wr8 (wr8 m a (v.setWidth 8)) (a + 1) ((v >>> 8).setWidth 8)) (a + 2)
    ((v >>> 16).setWidth 8)) (a + 3) ((v >>> 24).setWidth 8)) (a + 4) ((v >>> 32).setWidth 8)) (a + 5)
    ((v >>> 40).setWidth 8)) (a + 6) ((v >>> 48).setWidth 8)) (a + 7) ((v >>> 56).setWidth 8)

/-- Result flags of a logical operation. -/
def logicFlags {w : Nat} (r : BitVec w) : Flags := ⟨false, pf r, decide (r = 0), sf r, false⟩

/-- The eight ALU functions on `w`-bit operands with carry-in `c`: result and the new flags. -/
def aluW {w : Nat} (f : Fin 8) (a b : BitVec w) (c : Bool) : BitVec w × Flags :=
  let cn : Nat := if c then 1 else 0
  match f.val with
  | 0 => let r := a + b
         (r, ⟨decide (2 ^ w ≤ a.toNat + b.toNat), pf r, decide (r = 0), sf r, a.msb == b.msb && r.msb != a.msb⟩)
  | 1 => let r := a ||| b; (r, logicFlags r)
  | 2 => let r := a + b + BitVec.ofNat w cn
         (r, ⟨decide (2 ^ w ≤ a.toNat + b.toNat + cn), pf r, decide (r = 0), sf r, a.msb == b.msb && r.msb != a.msb⟩)
  | 3 => let r := a - b - BitVec.ofNat w cn
         (r, ⟨decide (a.toNat < b.toNat + cn), pf r, decide (r = 0), sf r, a.msb != b.msb && r.msb != a.msb⟩)
  | 4 => let r := a &&& b; (r, logicFlags r)
  | 6 => let r := a ^^^ b; (r, logicFlags r)
  | _ => let r := a - b       -- 5 SUB and 7 CMP
         (r, ⟨decide (a.toNat < b.toNat), pf r, decide (r = 0), sf r, a.msb != b.msb && r.msb != a.msb⟩)

/-- Condition codes of `Jcc` / `SETcc` (SDM Vol. 2 condition-code table). -/
def cond (cc : Fin 16) (fl : Flags) : Bool :=
  match cc.val with
  | 0 => fl.ovf | 1 => !fl.ovf | 2 => fl.cf | 3 => !fl.cf | 4 => fl.zf | 5 => !fl.zf
  | 6 => fl.cf || fl.zf | 7 => !fl.cf && !fl.zf | 8 => fl.sf | 9 => !fl.sf | 10 => fl.pf | 11 => !fl.pf
  | 12 => fl.sf != fl.ovf | 13 => fl.sf == fl.ovf | 14 => fl.zf || (fl.sf != fl.ovf)
  | _ => !fl.zf && (fl.sf == fl.ovf)

/-- Address of a `[rip + disp32]` operand: the address of the next instruction plus the sign-extended displacement. -/
def ripEA (rip len : Nat) (disp : BitVec 32) : Nat := (Int.ofNat (rip + len) + disp.toInt).toNat

/-- Shift; flags: CF = last bit shifted out, others from the result (count 0 changes nothing). -/
def shiftW {w : Nat} (left : Bool) (a : BitVec w) (cnt : Nat) (old : Flags) : BitVec w × Flags :=
  if cnt = 0 then (a, old)
  else
    let r := if left then a <<< cnt else a >>> cnt
    let out := if left then a.getLsbD (w - cnt) else a.getLsbD (cnt - 1)
    (r, ⟨out, pf r, decide (r = 0), sf r, false⟩)

/-- Execute a decoded instruction of length `len` from state `s`. -/
def exec (i : Instr) (len : Nat) (s : St) : St :=
  let s' := { s with rip := s.rip + len }
  match i with
  | .alu f d r =>
    let p := aluW f (s.regs d) (s.regs r) s.fl.cf
    let s2 := { s' with fl := p.2 }
    if f = 7 then s2 else s2.setReg d p.1
  | .aluM f d b =>
    let p := aluW f (s.regs d) (rd64 s.mem (s.regs b).toNat) s.fl.cf
    let s2 := { s' with fl := p.2 }
    if f = 7 then s2 else s2.setReg d p.1
  | .movRR d r => s'.setReg d (s.regs r)
  | .movStore b r => { s' with mem := wr64 s.mem (s.regs b).toNat (s.regs r) }
  | .aluRI f r imm =>
    let p := aluW f (s.regs r) (imm.signExtend 64) s.fl.cf
    let s2 := { s' with fl := p.2 }
    if f = 7 then s2 else s2.setReg r p.1
  | .aluRI8_32 f r imm =>
    let p := aluW f ((s.regs r).setWidth 32) (imm.signExtend 32) s.fl.cf
    let s2 := { s' with fl := p.2 }
    if f = 7 then s2 else s2.setReg r (p.1.setWidth 64)
  | .shiftI k r n =>
    let p := shiftW (k.val = 4) (s.regs r) (n.toNat % 64) s.fl
    { s'.setReg r p.1 with fl := p.2 }
  | .dec r =>
    let a := s.regs r
    let res := a - 1
    { s'.setReg r res with fl := ⟨s.fl.cf, pf res, decide (res = 0), sf res, decide (a = BitVec.intMin 64)⟩ }
  | .imulI d r imm =>
    let full : Int := (s.regs r).toInt * imm.toInt
    let res : BitVec 64 := BitVec.ofInt 64 full
    { s'.setReg d res with fl := ⟨decide (res.toInt ≠ full), pf res, decide (res = 0), sf res, decide (res.toInt ≠ full)⟩ }
  | .movI32 r imm => s'.setReg r (imm.signExtend 64)
  | .movI64 r imm => s'.setReg r imm
  | .leaD d b x => s'.setReg d (s.regs b + x.signExtend 64)
  | .leaSib d b i => s'.setReg d (s.regs b + s.regs i)
  | .setcc cc r => s'.setLow8 r (if cond cc s.fl then 1 else 0)
  | .shlB r n =>
    let p := shiftW true (s.low8 r) (n.toNat % 32) s.fl
    { s'.setLow8 r p.1 with fl := p.2 }
  | .orB d r =>
    let res := s.low8 d ||| s.low8 r
    { s'.setLow8 d res with fl := logicFlags res }
  | .xorMB disp r =>
    let a := ripEA s.rip len disp
    let res := (s.mem a) ^^^ s.low8 r
    { s' with mem := wr8 s.mem a res, fl := logicFlags res }
  | .aluMR32 f disp r =>
    let a := ripEA s.rip len disp
    let p := aluW f (rd32 s.mem a) ((s.regs r).setWidth 32) s.fl.cf
    { s' with fl := p.2, mem := if f = 7 then s.mem else wr32 s.mem a p.1 }
  | .aluMR64 f disp r =>
    let a := ripEA s.rip len disp
    let p := aluW f (rd64 s.mem a) (s.regs r) s.fl.cf
    { s' with fl := p.2, mem := if f = 7 then s.mem else wr64 s.mem a p.1 }
  | .clc => { s' with fl := { s.fl with cf := false } }
  | .jcc cc rel =>
    if cond cc s.fl then { s with rip := (Int.ofNat (s.rip + len) + rel.toInt).toNat } else s'
  | .jmp32 rel => { s with rip := (Int.ofNat (s.rip + len) + rel.toInt).toNat }
  | .nop => s'

/-- One step: decode at `rip` in the current memory and execute; `none` if the bytes do not decode. -/
def step (s : St) : Option St :=
  match decode s.mem s.rip with
  | none => none
  | some (i, len) => some (exec i len s)

/-- `n` steps. -/
def run : Nat → St → Option St
  | 0, s => some s
  | n + 1, s => (step s).bind (run n)

end SmcTamper
-- ===== SmcTamper.Spec.Kernel =====
namespace SmcTamper

structure KState where
  mem : Mem
  ptr : Nat
  sum : BitVec 64

/-- Result and new sum of the ALU function selected by an opcode byte (`aluField`), with carry clear. -/
def kAlu (opb : BitVec 8) (sum d : BitVec 64) : BitVec 64 × BitVec 64 :=
  let p := aluW (Fin.ofNat 8 (aluField opb)) sum d false
  (p.1, if aluField opb = 7 then sum else p.1)

/-- One iteration of the static kernel (Fig. 2) with the opcode byte at address `opAddr`. -/
def staticStep (opAddr : Nat) (k : KState) : KState :=
  let opb := k.mem opAddr
  let r := kAlu opb k.sum (rd64 k.mem k.ptr)
  { mem := wr8 k.mem opAddr (opb ^^^ (BitVec.ofNat 8 (toggle r.1) <<< 3)), ptr := k.ptr + 8, sum := r.2 }

/-- `n` iterations. -/
def staticRun (opAddr : Nat) : Nat → KState → KState
  | 0, k => k
  | n + 1, k => staticRun opAddr n (staticStep opAddr k)

end SmcTamper
-- ===== SmcTamper.Spec.Detection =====
namespace SmcTamper

structure CheckUnit where
  opAddr : Nat
  start : Nat
  size : Nat
  canon : BitVec 8

/-- The final machine state of one run on the memory `m`. -/
def CheckUnit.run (u : CheckUnit) (m : Mem) : KState := staticRun u.opAddr (u.size / 8) ⟨m, u.start, 0⟩

/-- The value of a run: final sum and final opcode byte. -/
def CheckUnit.value (u : CheckUnit) (m : Mem) : BitVec 64 × BitVec 8 :=
  ((u.run m).sum, (u.run m).mem u.opAddr)

/-- The canonical memory of a unit: the protected image `m` with the opcode byte in its canonical state. -/
def CheckUnit.reset (u : CheckUnit) (m : Mem) : Mem := wr8 m u.opAddr u.canon

/-- The tamper-proofing predicate on one run: the value matches the expected one and the measured time is within `τ`. -/
def CheckUnit.P (u : CheckUnit) (expected : BitVec 64 × BitVec 8) (τ : Nat) (m : Mem) (t : Nat) : Prop :=
  u.value m = expected ∧ t ≤ τ

/-- `k` consecutive failures ending at run `t`: the alarm of the policy. -/
def alarm (k : Nat) (ok : Nat → Bool) (t : Nat) : Prop := k ≤ t + 1 ∧ ∀ i, i < k → ok (t - i) = false

end SmcTamper
-- ===== SmcTamper.Spec.Threat =====
namespace SmcTamper

structure VState where
  F : Mem
  D : Mem
  ptr : Nat
  sum : BitVec 64

/-- One iteration of the static kernel with the opcode fetched from the fetch view `F` and data and writes on the data view
`D`; with `med` the adversary copies the written opcode byte into `F` (a *mediation*). -/
def vStep (opAddr : Nat) (med : Bool) (s : VState) : VState :=
  let opb := s.F opAddr
  let r := kAlu opb s.sum (rd64 s.D s.ptr)
  let nd := s.D opAddr ^^^ (BitVec.ofNat 8 (toggle r.1) <<< 3)
  { F := if med then wr8 s.F opAddr nd else s.F, D := wr8 s.D opAddr nd, ptr := s.ptr + 8, sum := r.2 }

def vRun (opAddr : Nat) (med : Nat → Bool) : Nat → Nat → VState → VState
  | _, 0, s => s
  | i, n + 1, s => vRun opAddr med (i + 1) n (vStep opAddr (med i) s)

/-- The value of a check on the views `F`, `D`: the unit resets its opcode byte (in the data view; in the fetch view too iff
the views are one image, `coh`), then runs. -/
def viewValue (cu : CheckUnit) (coh : Bool) (F D : Mem) (med : Nat → Bool) : BitVec 64 × BitVec 8 :=
  let D0 := wr8 D cu.opAddr cu.canon
  let F0 := if coh then D0 else F
  let s := vRun cu.opAddr med 0 (cu.size / 8) ⟨F0, D0, cu.start, 0⟩
  (s.sum, s.D cu.opAddr)

structure CUnit where
  cu : CheckUnit
  code : Nat → Prop
  resp : Nat → Prop
  tau : Nat
  native : Nat

structure Sys where
  I0 : Mem
  n : Nat
  unit : Nat → CUnit
  prot : Nat → Prop
  ops : Nat → Prop
  k : Nat

def Sys.expected (S : Sys) (x : Nat) : BitVec 64 × BitVec 8 := (S.unit x).cu.value ((S.unit x).cu.reset S.I0)

def Sys.inRegion (S : Sys) (x a : Nat) : Prop :=
  (S.unit x).cu.start ≤ a ∧ a < (S.unit x).cu.start + 8 * ((S.unit x).cu.size / 8)

/-- Platform cost contract (D2): lower bounds on the elapsed time of the adversary's check paths. -/
structure Cost where
  emulLB : Nat → Nat
  kd : Nat
  km : Nat

inductive Level where
  | L0 | L1 | L2 | L3 | L4
  deriving DecidableEq

def Level.rank : Level → Nat
  | .L0 => 0 | .L1 => 1 | .L2 => 2 | .L3 => 3 | .L4 => 4

/-- Where the timing readings come from: the inline `RDTSC`/`RDTSCP` of the protected code, or an operating-system timer API. -/
inductive TimerSrc where
  | tsc | osApi
  deriving DecidableEq

/-- Capability (R-class, plan D11): hooking an OS timer API needs user mode; trapping or offsetting `RDTSC` needs ring 0
(`CR4.TSD`) or a hypervisor (RDTSC exiting, TSC offsetting). -/
def Level.forgesReading (l : Level) : TimerSrc → Prop
  | .osApi => 1 ≤ l.rank
  | .tsc => 2 ≤ l.rank

inductive CheckPath where
  | honest
  | emulated
  | forged
  | neutral
  | mediated (med : Nat → Bool)

inductive TEv where
  | exec (a : Nat)
  | check (x : Nat) (p : CheckPath) (elapsed reading : Nat)
  | write (a : Nat) (b : BitVec 8)
  | splitWrite (a : Nat) (b : BitVec 8)
  | dmaWrite (a : Nat) (b : BitVec 8)
  | regWrite
  | idle

structure World where
  F : Mem
  D : Mem
  split : Bool

def World.init (S : Sys) : World := ⟨S.I0, S.I0, false⟩

def stepW (w : World) : TEv → World
  | .write a b => { w with F := wr8 w.F a b, D := wr8 w.D a b }
  | .splitWrite a b => { w with F := wr8 w.F a b, split := true }
  | .dmaWrite a b => { w with F := wr8 w.F a b, D := wr8 w.D a b }
  | _ => w

/-- The world before event `n` of the stream `tl`. -/
def worldAt (S : Sys) (tl : Nat → TEv) : Nat → World
  | 0 => World.init S
  | n + 1 => stepW (worldAt S tl n) (tl n)

/-- Whether a check on the world `w` along path `p` produces the expected value. -/
def checkOk (S : Sys) (w : World) (x : Nat) : CheckPath → Prop
  | .honest => viewValue (S.unit x).cu (!w.split) w.F w.D (fun _ => !w.split) = S.expected x
  | .emulated => True
  | .forged => True
  | .neutral => True
  | .mediated med => viewValue (S.unit x).cu false w.F w.D med = S.expected x

/-- What the cost contract admits for an event (platform facts, not security assumptions). -/
def Cost.admits (C : Cost) (S : Sys) : TEv → Prop
  | .check x .emulated e _ => C.emulLB x ≤ e
  | .check x .forged e _ => (S.unit x).native + C.kd ≤ e
  | .check x (.mediated med) e _ =>
      (S.unit x).native + C.km * ((List.range ((S.unit x).cu.size / 8)).countP med) ≤ e
  | .check x .honest e _ => e = (S.unit x).native
  | _ => True

/-- What each adversary level may emit.  A check event whose reading differs from the elapsed time needs the capability to
forge the timer in use. -/
def Level.allows (l : Level) (t : TimerSrc) (tl : Nat → TEv) (i : Nat) : TEv → Prop
  | .exec _ => True
  | .idle => True
  | .regWrite => 1 ≤ l.rank
  | .write _ _ => 1 ≤ l.rank ∨ (l = .L0 ∧ ∀ j, j < i → ∃ a b, tl j = .write a b)
  | .splitWrite _ _ => 2 ≤ l.rank
  | .dmaWrite _ _ => 4 ≤ l.rank
  | .check _ p e r =>
      (r = e ∨ l.forgesReading t) ∧
      (match p with
       | .honest => True
       | .emulated => 1 ≤ l.rank
       | .forged => 1 ≤ l.rank
       | .neutral => 1 ≤ l.rank
       | .mediated _ => 2 ≤ l.rank)

/-- The check schedule: `ck x m` is the stream index of the `m`-th check of unit `x`. -/
structure Sched (n : Nat) (tl : Nat → TEv) where
  ck : Nat → Nat → Nat
  incr : ∀ x m, ck x m < ck x (m + 1)
  isChk : ∀ x m, x < n → ∃ p e r, tl (ck x m) = TEv.check x p e r
  complete : ∀ i x p e r, tl i = TEv.check x p e r → x < n → ∃ m, ck x m = i

/-- Event well-formedness: levels, the cost contract, and the meaning of the check paths. -/
structure WF (S : Sys) (C : Cost) (l : Level) (t : TimerSrc) (tl : Nat → TEv) : Prop where
  lvl : ∀ i, l.allows t tl i (tl i)
  cost : ∀ i, C.admits S (tl i)
  honestCode : ∀ i x e r, tl i = TEv.check x .honest e r →
    ∀ a, (S.unit x).code a → ¬ S.ops a → (worldAt S tl i).F a = S.I0 a
  neutralMod : ∀ i x e r, tl i = TEv.check x .neutral e r →
    ∃ a, (S.unit x).code a ∧ ¬ S.ops a ∧ (worldAt S tl i).F a ≠ S.I0 a
  medSplit : ∀ i x med e r, tl i = TEv.check x (.mediated med) e r → (worldAt S tl i).split = true

def timeFailAt (S : Sys) (tl : Nat → TEv) (c x : Nat) : Prop :=
  ∃ p e r, tl c = TEv.check x p e r ∧ (S.unit x).tau < r

def valueFailAt (S : Sys) (tl : Nat → TEv) (c x : Nat) : Prop :=
  ∃ p e r, tl c = TEv.check x p e r ∧ ¬ checkOk S (worldAt S tl c) x p

/-- A unit has a response mechanism and it is never modified (so its alarm takes effect): there is at least one response byte, and
every response byte keeps its original value. A unit without any response byte has nothing that could take effect. -/
def RespIntact (S : Sys) (tl : Nat → TEv) (x : Nat) : Prop :=
  (∃ a, (S.unit x).resp a) ∧ ∀ n a, (S.unit x).resp a → (worldAt S tl n).F a = S.I0 a

/-- An effective alarm: some unit with an intact response code sees a value mismatch, or a positive number `k` of consecutive
timing failures (with `k = 0` the timing branch would hold with no failed check at all, so it is excluded). -/
def Alarm (S : Sys) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop :=
  ∃ x, x < S.n ∧ RespIntact S tl x ∧
    ((∃ m, valueFailAt S tl (sch.ck x m) x) ∨
      (0 < S.k ∧ ∃ s, ∀ j, j < S.k → timeFailAt S tl (sch.ck x (s + j)) x))

/-- Goal (a): a protected, non-opcode byte is executed while the fetch view differs from the original image. -/
def ExecViolation (S : Sys) (tl : Nat → TEv) : Prop :=
  ∃ j a, tl j = TEv.exec a ∧ S.prot a ∧ ¬ S.ops a ∧ (worldAt S tl j).F a ≠ S.I0 a

def Wins (S : Sys) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop := ExecViolation S tl ∧ ¬ Alarm S tl sch

/-- `x` covers `y`: `x`'s region contains all of `y`'s own code (other than opcode bytes). -/
def Covers (S : Sys) (x y : Nat) : Prop := ∀ a, (S.unit y).code a → ¬ S.ops a → S.inRegion x a

/-- Paths in the covers graph among the `n` units. -/
inductive Reach (S : Sys) : Nat → Nat → Prop where
  | refl {x : Nat} : x < S.n → Reach S x x
  | step {x y z : Nat} : Reach S x y → z < S.n → Covers S y z → Reach S x z

/-- Unit `x`'s own code (outside the opcode bytes) is modified by some write. -/
def ModWrite (S : Sys) (tl : Nat → TEv) (x : Nat) : Prop :=
  ∃ i a b, tl i = TEv.write a b ∧ (S.unit x).code a ∧ ¬ S.ops a ∧ b ≠ S.I0 a

def Intact (S : Sys) (tl : Nat → TEv) (x : Nat) : Prop := ¬ ModWrite S tl x

/-- A1 coherence: the fetch view and the data view are one image throughout. -/
def A1 (S : Sys) (tl : Nat → TEv) : Prop := ∀ n, (worldAt S tl n).split = false

/-- A2 coverage: every protected byte lies in some unit's region. -/
def A2cov (S : Sys) : Prop := ∀ a, S.prot a → ∃ x, x < S.n ∧ S.inRegion x a

/-- A2: every unit's code is protected. -/
def A2code (S : Sys) : Prop := ∀ x, x < S.n → ∀ a, (S.unit x).code a → S.prot a

/-- A2: the covers graph is strongly connected. -/
def A2conn (S : Sys) : Prop := ∀ x y, x < S.n → y < S.n → Reach S x y

/-- A2: at least one unit's code is never modified. -/
def A2intact (S : Sys) (tl : Nat → TEv) : Prop := ∃ v, v < S.n ∧ Intact S tl v

/-- A3 timing gap: native time ≤ threshold < emulation / debug-trap / mediation lower bound. -/
def A3 (S : Sys) (C : Cost) : Prop := ∀ x, x < S.n → (S.unit x).native ≤ (S.unit x).tau ∧ (S.unit x).tau < C.emulLB x ∧
    (S.unit x).tau < (S.unit x).native + C.kd ∧ (S.unit x).tau < (S.unit x).native + C.km

/-- A4: no writer outside the protected thread (DMA, other bus masters) acts. -/
def A4 (tl : Nat → TEv) : Prop := ∀ i a b, tl i ≠ TEv.dmaWrite a b

/-- A5 time integrity: every reading equals the elapsed time. -/
def A5 (tl : Nat → TEv) : Prop := ∀ i x p e r, tl i = TEv.check x p e r → r = e

/-- A6 persistence: the alarm count `k` is positive, and a modifying write persists through the next `k` scheduled checks of
every unit covering the byte. -/
def A6 (S : Sys) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop :=
  0 < S.k ∧ ∀ i a b x m0, tl i = TEv.write a b → S.prot a → ¬ S.ops a → b ≠ S.I0 a → x < S.n → S.inRegion x a →
    i < sch.ck x m0 → (m0 = 0 ∨ sch.ck x (m0 - 1) ≤ i) →
    ∀ j, j < S.k → (worldAt S tl (sch.ck x (m0 + j))).D a ≠ S.I0 a

/-- A7 response coverage: each unit has a response code (at least one response byte), and all of it is part of the unit's own
(protected) code. -/
def A7 (S : Sys) : Prop := ∀ x, x < S.n → (∃ a, (S.unit x).resp a) ∧ ∀ a, (S.unit x).resp a → (S.unit x).code a ∧ ¬ S.ops a

/-- A8 non-compensation: whenever a modification lies in the region of an honestly running unit, its result differs. -/
def A8 (S : Sys) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop :=
  ∀ x m e r, x < S.n → tl (sch.ck x m) = TEv.check x .honest e r →
    (∃ a, S.inRegion x a ∧ ¬ S.ops a ∧ (worldAt S tl (sch.ck x m)).D a ≠ S.I0 a) →
    ¬ checkOk S (worldAt S tl (sch.ck x m)) x .honest

structure Assumptions (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop where
  a1 : A1 S tl
  a2cov : A2cov S
  a2code : A2code S
  a2conn : A2conn S
  a2intact : A2intact S tl
  a3 : A3 S C
  a4 : A4 tl
  a5 : A5 tl
  a6 : A6 S tl sch
  a7 : A7 S
  a8 : A8 S tl sch

end SmcTamper
-- ===== SmcTamper.Spec.Harvard =====
namespace SmcTamper

structure Harvard (C : Type) where
  readAddr : C → Nat
  next : C → BitVec 8 → C
  write : C → BitVec 8 → Option (Nat × BitVec 8)

/-- Apply an optional write. -/
def applyWrite (m : Mem) : Option (Nat × BitVec 8) → Mem
  | none => m
  | some (a, v) => wr8 m a v

def Harvard.step {C : Type} (H : Harvard C) (c : C) (m : Mem) : C × Mem :=
  let b := m (H.readAddr c)
  (H.next c b, applyWrite m (H.write c b))

def Harvard.run {C : Type} (H : Harvard C) : Nat → C → Mem → C × Mem
  | 0, c, m => (c, m)
  | n + 1, c, m => H.run n (H.step c m).1 (H.step c m).2

/-- The data addresses read by the first `n` steps. -/
def Harvard.reads {C : Type} (H : Harvard C) : Nat → C → Mem → List Nat
  | 0, _, _ => []
  | n + 1, c, m => H.readAddr c :: H.reads n (H.step c m).1 (H.step c m).2

structure VonNeumann (S : Type) where
  L : Nat
  w : Nat
  pc : S → Nat
  dataAddr : S → (Fin L → BitVec 8) → Fin w → Nat
  exec : S → (Fin L → BitVec 8) → (Fin w → BitVec 8) → S × Option (Nat × BitVec 8)

/-- One von Neumann step: fetch `L` bytes at `pc`, read `w` data bytes, execute and write, all in one memory. -/
def VonNeumann.step {S : Type} (V : VonNeumann S) (s : S) (m : Mem) : S × Mem :=
  let win : Fin V.L → BitVec 8 := fun i => m (V.pc s + i.val)
  let dv : Fin V.w → BitVec 8 := fun j => m (V.dataAddr s win j)
  let r := V.exec s win dv
  (r.1, applyWrite m r.2)

end SmcTamper
-- ===== SmcTamper.Spec.Paper =====
namespace SmcTamper.Paper

/-- T1 (security). For every well-formed timeline (levels, cost contract, check paths) of a system that satisfies A1-A8: if a
protected byte outside the SMC opcode bytes `ops` is ever executed while the fetch view differs from the original image at that
byte (`ExecViolation`), then an effective alarm (`Alarm`) occurs somewhere in the infinite timeline, not necessarily before that
execution. The SMC opcode bytes legitimately vary, so executing one in a changed state is outside the goal. -/
def SecurityTheorem : Prop :=
  ∀ (S : Sys) (C : Cost) (l : Level) (t : TimerSrc) (tl : Nat → TEv) (sch : Sched S.n tl),
    WF S C l t tl → Assumptions S C tl sch → ¬ Wins S tl sch

/-- The assumption with the given number, when it is the only one that can be dropped. The numbering is: 1 A1, 2 A2 coverage,
3 A3, 4 A4, 5 A5, 6 A6, 7 A7, 8 A8, 12 A2 intact unit, 13 A2 code protected, 14 A2 connectivity. -/
def OthersHold (i : Nat) (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop :=
  (i = 1 ∨ A1 S tl) ∧ (i = 2 ∨ A2cov S) ∧ (i = 13 ∨ A2code S) ∧ (i = 14 ∨ A2conn S) ∧ (i = 12 ∨ A2intact S tl) ∧
  (i = 3 ∨ A3 S C) ∧ (i = 4 ∨ A4 tl) ∧ (i = 5 ∨ A5 tl) ∧ (i = 6 ∨ A6 S tl sch) ∧ (i = 7 ∨ A7 S) ∧ (i = 8 ∨ A8 S tl sch)

/-- The assumption numbered `i` holds. -/
def HoldsAt (i : Nat) (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl) : Prop :=
  match i with
  | 1 => A1 S tl
  | 2 => A2cov S
  | 3 => A3 S C
  | 4 => A4 tl
  | 5 => A5 tl
  | 6 => A6 S tl sch
  | 7 => A7 S
  | 8 => A8 S tl sch
  | 12 => A2intact S tl
  | 13 => A2code S
  | 14 => A2conn S
  | _ => True

/-- Assumption `i` is necessary: some well-formed system satisfies all the others, the adversary wins, and `i` fails. -/
def NecessaryAssumption (i : Nat) : Prop :=
  ∃ (S : Sys) (C : Cost) (l : Level) (t : TimerSrc) (tl : Nat → TEv) (sch : Sched S.n tl),
    WF S C l t tl ∧ OthersHold i S C tl sch ∧ Wins S tl sch ∧ ¬ HoldsAt i S C tl sch

/-- T3: each of the eleven assumptions (A1, A2 coverage, A2 code protected, A2 connectivity, A2 intact unit, A3, A4, A5, A6, A7, A8)
is necessary within this model: some well-formed system satisfies the other ten, has an adversary that wins, and violates it. -/
def AssumptionsNecessary : Prop :=
  NecessaryAssumption 1 ∧ NecessaryAssumption 2 ∧ NecessaryAssumption 3 ∧ NecessaryAssumption 4 ∧ NecessaryAssumption 5 ∧
  NecessaryAssumption 6 ∧ NecessaryAssumption 7 ∧ NecessaryAssumption 8 ∧ NecessaryAssumption 12 ∧ NecessaryAssumption 13 ∧
  NecessaryAssumption 14

/-- The toggle produced by the next iteration of the split-view kernel, whose opcode is fetched from the view `F`. -/
def ToggleAt (opAddr : Nat) (s : VState) : Nat := toggle (kAlu (s.F opAddr) s.sum (rd64 s.D s.ptr)).1

/-- A faithful run: the fetched opcode equals the data-view opcode at the start of each of the `n` iterations. -/
def FaithfulRun (opAddr : Nat) (med : Nat → Bool) : Nat → Nat → VState → Prop
  | _, 0, _ => True
  | i, n + 1, s => s.F opAddr = s.D opAddr ∧ FaithfulRun opAddr med (i + 1) n (vStep opAddr (med i) s)

/-- T2: a faithful run mediates every iteration whose toggle is non-zero (apart from the last), and under A3 and A5 a faithful
mediated check that the cost contract admits, with such an iteration, is a timing failure (its reading exceeds the threshold).
It does not say that every split-view attack is detected. -/
def MediationTheorem : Prop :=
  (∀ (opAddr : Nat) (med : Nat → Bool) (n i : Nat) (s : VState), FaithfulRun opAddr med i n s → ∀ j, j + 1 < n →
      ToggleAt opAddr (vRun opAddr med i j s) ≠ 0 → med (i + j) = true) ∧
  (∀ (S : Sys) (C : Cost) (tl : Nat → TEv), A3 S C → A5 tl → ∀ (c x : Nat) (med : Nat → Bool) (e r : Nat), x < S.n →
      tl c = TEv.check x (.mediated med) e r → C.admits S (tl c) → ∀ s0 : VState,
      FaithfulRun (S.unit x).cu.opAddr med 0 ((S.unit x).cu.size / 8) s0 → ∀ j, j + 1 < (S.unit x).cu.size / 8 →
      ToggleAt (S.unit x).cu.opAddr (vRun (S.unit x).cu.opAddr med 0 j s0) ≠ 0 → timeFailAt S tl c x)

/-- T4: what each level gives and loses, as the model's level capabilities define them. Every well-formed timeline at level L0 or
L1 with the inline timer satisfies A1, A4 and A5. Conversely there is a winning adversary against a system satisfying every
assumption except one (`OthersHold`, as in T3): at L1 with an operating-system timer and at L2 the one is A5, at L2 also A1, at L4
A4. The capabilities themselves are contract fields (`Level.allows`), not facts about a real system. -/
def LevelMatrix : Prop :=
  (∀ (S : Sys) (C : Cost) (l : Level) (tl : Nat → TEv), WF S C l .tsc tl → l.rank < 2 → A1 S tl ∧ A4 tl ∧ A5 tl) ∧
  (∃ (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl),
      WF S C .L1 .osApi tl ∧ OthersHold 5 S C tl sch ∧ Wins S tl sch ∧ ¬ A5 tl) ∧
  (∃ (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl),
      WF S C .L2 .tsc tl ∧ OthersHold 5 S C tl sch ∧ Wins S tl sch ∧ ¬ A5 tl) ∧
  (∃ (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl),
      WF S C .L2 .tsc tl ∧ OthersHold 1 S C tl sch ∧ Wins S tl sch ∧ ¬ A1 S tl) ∧
  (∃ (S : Sys) (C : Cost) (tl : Nat → TEv) (sch : Sched S.n tl),
      WF S C .L4 .tsc tl ∧ OthersHold 4 S C tl sch ∧ Wins S tl sch ∧ ¬ A4 tl)

end SmcTamper.Paper
namespace PalomarSMT
/-- Security under A1-A8, mediation cost, necessity of the assumptions, and the level matrix. -/
theorem mathematical_result : SmcTamper.Paper.SecurityTheorem ∧ SmcTamper.Paper.AssumptionsNecessary ∧
    SmcTamper.Paper.MediationTheorem ∧ SmcTamper.Paper.LevelMatrix := by
  sorry
end PalomarSMT
