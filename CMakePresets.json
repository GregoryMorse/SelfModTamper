{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Uses the Visual Studio 2026 generator; the preset windows-x64-vs2022 uses Visual Studio 2022. The Visual Studio solution is the authoritative build; CMake is the secondary route.",
      "binaryDir": "${sourceDir}/build",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-vs2022",
      "inherits": "windows-x64",
      "displayName": "Windows x64 (vcpkg, Visual Studio 2022)",
      "binaryDir": "${sourceDir}/build-vs2022",
      "generator": "Visual Studio 17 2022"
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    }
  ]
}