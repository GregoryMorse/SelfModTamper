<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{157193a2-a02d-4f73-a9fc-f3d482cae9da}</ProjectGuid>
    <RootNamespace>SelfModTamper</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- v145 (Visual Studio 2026) by default, v143 (Visual Studio 2022) when the toolset is not installed or is passed as /p:PlatformToolset=v143 -->
    <PlatformToolset Condition="'$(PlatformToolset)'==''">$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- Every build product stays under build\msbuild; nothing is written to the source folders. -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <MsbuildRoot>$(RepoRoot)build\msbuild\$(PlatformToolset)\</MsbuildRoot>
    <OutDir>$(MsbuildRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MsbuildRoot)obj\$(Platform)\$(Configuration)\</IntDir>
    <AsmjitRoot>$(RepoRoot)build\deps\asmjit\</AsmjitRoot>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PreprocessorDefinitions>_CONSOLE;ASMJIT_STATIC;ASMJIT_NO_FOREIGN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(AsmjitRoot)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(OutDir)TP.obj;advapi32.lib;Mincore.lib;Winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/SECTION:.text,RWE %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <PreLinkEvent>
      <Command>ml64.exe /nologo /DX64 /Fo "$(OutDir)TP.obj" /Fl"$(OutDir)TP.lst" /c "$(MSBuildProjectDirectory)\TP.asm"</Command>
    </PreLinkEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="SelfModTamper.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Text Include="TP.asm">
      <FileType>Document</FileType>
    </Text>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- asmjit: downloaded once (pinned URL, SHA-512 checked by cmake\fetch_asmjit.cmake) into build\deps and compiled with the project. -->
  <PropertyGroup>
    <CMakeExe Condition="'$(CMakeExe)'==''">cmake</CMakeExe>
    <CMakeExe Condition="Exists('$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe') And !$([System.String]::Copy('$(PATH)').Contains('CMake'))">$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
  </PropertyGroup>
  <Target Name="FetchAsmjit" BeforeTargets="SelectClCompile;ClCompile">
    <Exec Command="&quot;$(CMakeExe)&quot; -DDEST=&quot;$(AsmjitRoot.TrimEnd('\'))&quot; -P &quot;$(RepoRoot)cmake\fetch_asmjit.cmake&quot;" />
    <MakeDir Directories="$(IntDir)asmjit" />
    <ItemGroup>
      <ClCompile Include="$(AsmjitRoot)src\asmjit\core\*.cpp;$(AsmjitRoot)src\asmjit\x86\*.cpp">
        <ObjectFileName>$(IntDir)asmjit\</ObjectFileName>
        <WarningLevel>TurnOffAllWarnings</WarningLevel>
        <SDLCheck>false</SDLCheck>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>