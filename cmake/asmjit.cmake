# asmjit, fetched and built by CMake from the pinned, hash-checked source archive (cmake/asmjit_pin.cmake); no vcpkg.
include(${CMAKE_CURRENT_LIST_DIR}/asmjit_pin.cmake)
include(FetchContent)
set(ASMJIT_STATIC ON CACHE BOOL "" FORCE)
set(ASMJIT_TEST OFF CACHE BOOL "" FORCE)
set(ASMJIT_NO_INSTALL ON CACHE BOOL "" FORCE)
FetchContent_Declare(asmjit URL ${ASMJIT_URL} URL_HASH SHA512=${ASMJIT_SHA512} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(asmjit)
if(NOT TARGET asmjit::asmjit)
    add_library(asmjit::asmjit ALIAS asmjit)
endif()
